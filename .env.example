# Copy to .env (never commit .env). Generate FERNET_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_URL=postgresql+asyncpg://kalpi:kalpi@db:5432/kalpi
FERNET_KEY=
API_KEYS=demo:change-me-demo-key
WEBHOOK_SECRET=change-me-webhook-secret
